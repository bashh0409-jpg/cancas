# =============================================================================
# CanvasAI — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# For production deployment to www.swipes.site, use the production values below.
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App URLs (change these per environment) ---
# Production (www.swipes.site):
# NEXT_PUBLIC_APP_URL=https://www.swipes.site
# NEXT_PUBLIC_SITE_URL=https://www.swipes.site
#
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key

# --- Google OAuth (Sign-In) ---
# Redirect URIs to add in Google Cloud Console:
#   Production: https://www.swipes.site/api/auth/callback
#   Local:      http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Google Drive Integration ---
# Redirect URIs to add in Google Cloud Console:
#   Production: https://www.swipes.site/api/integrations/google-drive/callback
#   Local:      http://localhost:3000/api/integrations/google-drive/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback
# GOOGLE_REDIRECT_URI=https://www.swipes.site/api/integrations/google-drive/callback

# --- Dropbox Integration ---
# Redirect URI to add in Dropbox App Console:
#   Production: https://www.swipes.site/api/integrations/dropbox/callback
#   Local:      http://localhost:3000/api/integrations/dropbox/callback
DROPBOX_CLIENT_ID=your-dropbox-client-id
DROPBOX_CLIENT_SECRET=your-dropbox-client-secret
DROPBOX_REDIRECT_URI=http://localhost:3000/api/integrations/dropbox/callback
# DROPBOX_REDIRECT_URI=https://www.swipes.site/api/integrations/dropbox/callback

# --- AI Providers ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Remove background (remove.bg) — used by /api/ai/remove-background
REMOVE_BACKGROUND_KEY=your-remove-bg-api-key

OPENAI_API_KEY=sk-proj-...
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

STABILITY_API_KEY=sk-...
STABILITY_MODEL=stable-image-core

FAL_API_KEY=...

# --- Upscaling ---
TOPAZ_API_KEY=...
TOPAZ_IMAGE_MODEL=Low Resolution V2

# --- Video ---
RUNWAY_API_KEY=key_...
KLING_API_KEY=api-key-kling-...

# --- Text-to-Speech ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

ELEVENLABS_API_KEY=sk_...

# --- Speech-to-Text ---
DEEPGRAM_API_KEY=...

# --- Billing: PayFast ---
# Redirect URIs to add in PayFast Dashboard:
#   Production: https://www.swipes.site/billing/success
#               https://www.swipes.site/billing/cancel
#               https://www.swipes.site/api/billing/webhooks/payfast
#   Local:      http://localhost:3000/billing/success
#               http://localhost:3000/billing/cancel
#               http://localhost:3000/api/billing/webhooks/payfast
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key
PAYFAST_RETURN_URL=http://localhost:3000/billing/success
PAYFAST_CANCEL_URL=http://localhost:3000/billing/cancel
PAYFAST_NOTIFY_URL=http://localhost:3000/api/billing/webhooks/payfast
# PAYFAST_RETURN_URL=https://www.swipes.site/billing/success
# PAYFAST_CANCEL_URL=https://www.swipes.site/billing/cancel
# PAYFAST_NOTIFY_URL=https://www.swipes.site/api/billing/webhooks/payfast

# --- Billing: Stripe ---
# Webhook endpoint to add in Stripe Dashboard:
#   Production: https://www.swipes.site/api/billing/webhooks/stripe
#   Local:      http://localhost:3000/api/billing/webhooks/stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_STARTER_ID=prod_...
STRIPE_PRODUCT_PRO_ID=prod_...
STRIPE_PRODUCT_ULTRA_ID=prod_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ULTRA_MONTHLY=price_...
STRIPE_PRICE_ULTRA_ANNUAL=price_...

# --- Email (Brevo) ---
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=no-reply@swipes.site
BREVO_SENDER_NAME=Reflow Inc

# --- Cron ---
CRON_SECRET=...

# --- App Name ---
NEXT_PUBLIC_APP_NAME=Reflow
